# Makefile for Inspect R/TikZ figure pipeline
# All production plots generated via R → CSV → TikZ → pdflatex
# Schematics (overview, categorymap) are TikZ-only

PDFLATEX := pdflatex -interaction=nonstopmode -halt-on-error
RSCRIPT := Rscript
# NOTE: this pipeline is Python-free. All figure data is generated by the R
# scripts in R/ and data/. (No PYTHON variable is needed.)

# Figure groups
RTIKZ_FIGS := fig-alphafrontier fig-binding-escaped fig-binding-fr \
              fig-calfraction fig-calplanning fig-crcbaseline \
              fig-deferral fig-g2delta fig-jointmon fig-mondrian-1 \
              fig-mondrian-2 fig-opcost fig-validity fig-xdet

TIKZ_ONLY := fig-categorymap fig-overview

R_CAIRO_FIGS := fig-samples fig-scoreanatomy

ALL_FIGS := $(RTIKZ_FIGS) $(TIKZ_ONLY) $(R_CAIRO_FIGS)
ALL_PDFS := $(addsuffix .pdf,$(ALL_FIGS))
RIE_FIG_DIR := ../rie/figures
AEI_FIG_DIR := ../aei/figures

# Data dependencies
CATBENCH := mvtec visa mpdd
CATTEX := $(addprefix data/categorymap_,$(addsuffix .tex,$(CATBENCH)))

.PHONY: all clean clean-data distclean r-data tikz verify sync-rie sync-aei sync-paper rie-paper
all: r-data $(ALL_PDFS)

# ============================================================================
# R data generation (CSV digests from frozen JSON)
# ============================================================================
r-data:
	@echo "=== Generating R CSV digests from frozen JSON (pure R pipeline) ==="
	cd R && $(RSCRIPT) binding.R
	cd R && $(RSCRIPT) deferral.R
	cd R && $(RSCRIPT) jointmon.R
	cd R && $(RSCRIPT) validity.R
	cd R && $(RSCRIPT) xdet.R
	cd R && $(RSCRIPT) process_deferral.R
	cd R && $(RSCRIPT) process_alphafrontier.R
	cd R && $(RSCRIPT) process_calfraction.R
	cd R && $(RSCRIPT) process_calplanning.R
	cd R && $(RSCRIPT) process_crcbaseline.R
	cd R && $(RSCRIPT) process_g2delta.R
	cd R && $(RSCRIPT) process_opcost.R
	cd R && $(RSCRIPT) normalize_mondrian.R
	@echo "=== R data generation complete ==="

# ============================================================================
# TikZ figures (R-backed)
# ============================================================================
fig-alphafrontier.pdf: tikz/fig-alphafrontier.tex R/alphafrontier_data.csv tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-alphafrontier.tex && mv fig-alphafrontier.pdf ../$@

out/binding-escaped-rows.tex out/binding-fr-rows.tex R/binding_escaped.csv R/binding_fr.csv &: R/binding.R ../../binding_demo_2026-07-13/results.json
	cd R && $(RSCRIPT) binding.R

fig-binding-escaped.pdf: tikz/fig-binding-escaped.tex R/binding_escaped.csv out/binding-escaped-rows.tex tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-binding-escaped.tex && mv fig-binding-escaped.pdf ../$@

fig-binding-fr.pdf: tikz/fig-binding-fr.tex R/binding_fr.csv out/binding-fr-rows.tex tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-binding-fr.tex && mv fig-binding-fr.pdf ../$@

fig-calfraction.pdf: tikz/fig-calfraction.tex R/calfraction_data.csv tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-calfraction.tex && mv fig-calfraction.pdf ../$@

fig-calplanning.pdf: tikz/fig-calplanning.tex R/calplanning_attainment.csv R/calplanning_observed.csv tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-calplanning.tex && mv fig-calplanning.pdf ../$@

fig-crcbaseline.pdf: tikz/fig-crcbaseline.tex out/crcbaseline-panel-a.tex out/crcbaseline-panel-b.tex out/crcbaseline-panel-c.tex R/crcbaseline_panel_a.csv R/crcbaseline_panel_b.csv R/crcbaseline_panel_c.csv tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-crcbaseline.tex && mv fig-crcbaseline.pdf ../$@

# CRC panel fragments are emitted by process_crcbaseline.R.
out/crcbaseline-panel-a.tex out/crcbaseline-panel-b.tex out/crcbaseline-panel-c.tex &: R/process_crcbaseline.R ../../baseline_comparison_2026-07-15/results.json
	cd R && $(RSCRIPT) process_crcbaseline.R

out/deferral-mvtec.tex out/deferral-visa.tex out/deferral-mpdd.tex &: R/process_deferral.R R/deferral.csv
	cd R && $(RSCRIPT) process_deferral.R

fig-deferral.pdf: tikz/fig-deferral.tex R/deferral.csv out/deferral-mvtec.tex out/deferral-visa.tex out/deferral-mpdd.tex tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-deferral.tex && mv fig-deferral.pdf ../$@

fig-g2delta.pdf: tikz/fig-g2delta.tex R/g2delta_mvtec.csv R/g2delta_mpdd.csv R/g2delta_deferral.csv R/g2delta_seeds.csv out/g2delta-panel-c.tex out/g2delta-panel-d.tex tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-g2delta.tex && mv fig-g2delta.pdf ../$@

out/jointmon-panel-a.tex out/jointmon-panel-b.tex out/jointmon-panel-c.tex out/jointmon-panel-d.tex R/jointmon_panel_a.csv R/jointmon_panel_b.csv R/jointmon_panel_c.csv R/jointmon_panel_d.csv &: R/jointmon.R ../../drift_joint_monitor_2026-08-01/results.json
	cd R && $(RSCRIPT) jointmon.R

fig-jointmon.pdf: tikz/fig-jointmon.tex R/jointmon_panel_a.csv R/jointmon_panel_b.csv R/jointmon_panel_c.csv R/jointmon_panel_d.csv out/jointmon-panel-a.tex out/jointmon-panel-b.tex out/jointmon-panel-c.tex out/jointmon-panel-d.tex tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-jointmon.tex && mv fig-jointmon.pdf ../$@

out/mondrian-1-rows.tex out/mondrian-2-rows.tex &: R/normalize_mondrian.R ../../mondrian_2026-07-19/results.json
	cd R && $(RSCRIPT) normalize_mondrian.R

fig-mondrian-1.pdf: tikz/fig-mondrian-1.tex tikz/mondrian_common.tex out/mondrian-1-rows.tex
	cd tikz && $(PDFLATEX) fig-mondrian-1.tex && mv fig-mondrian-1.pdf ../$@

fig-mondrian-2.pdf: tikz/fig-mondrian-2.tex tikz/mondrian_common.tex out/mondrian-2-rows.tex
	cd tikz && $(PDFLATEX) fig-mondrian-2.tex && mv fig-mondrian-2.pdf ../$@

fig-opcost.pdf: tikz/fig-opcost.tex R/opcost_grid.csv R/opcost_headroom.csv R/opcost_fourmethod.csv R/opcost_latency.csv out/opcost-panel-b.tex out/opcost-panel-c.tex out/opcost-panel-d.tex tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-opcost.tex && mv fig-opcost.pdf ../$@

# Opcost panel fragments (b/c/d) are emitted by process_opcost.R.
out/opcost-panel-b.tex out/opcost-panel-c.tex out/opcost-panel-d.tex &: R/process_opcost.R
	cd R && $(RSCRIPT) process_opcost.R

fig-validity.pdf: tikz/fig-validity.tex out/validity-panel-c.tex out/validity-panel-d.tex R/validity_escaped_points_patchcore.csv R/validity_escaped_points_dinomaly.csv R/validity_fr_points_patchcore.csv R/validity_fr_points_dinomaly.csv R/validity_escaped_means_patchcore.csv R/validity_escaped_means_dinomaly.csv R/validity_fr_means_patchcore.csv R/validity_fr_means_dinomaly.csv tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-validity.tex && mv fig-validity.pdf ../$@

# Validity cloud fragments (panels c/d) and per-backbone point/mean splits are
# emitted by validity.R (pure R; it sanitises the Infinity-laden transfer JSON
# with readLines+gsub, the same technique used in xdet.R).
out/validity-panel-c.tex out/validity-panel-d.tex R/validity_escaped_points_patchcore.csv R/validity_escaped_points_dinomaly.csv R/validity_fr_points_patchcore.csv R/validity_fr_points_dinomaly.csv R/validity_escaped_means_patchcore.csv R/validity_escaped_means_dinomaly.csv R/validity_fr_means_patchcore.csv R/validity_fr_means_dinomaly.csv &: R/validity.R data/frozen/validity_points.json ../../cross_detector_transfer_2026-08-01/results.json
	cd R && $(RSCRIPT) validity.R

out/xdet-panel-b.tex out/xdet-panel-b-meta.tex out/xdet-panel-c.tex out/xdet-panel-d.tex R/xdet_panel_a.csv R/xdet_panel_b.csv R/xdet_panel_c.csv R/xdet_panel_d.csv &: R/xdet.R ../../cross_detector_transfer_2026-08-01/results.json
	cd R && $(RSCRIPT) xdet.R

fig-xdet.pdf: tikz/fig-xdet.tex R/xdet_panel_a.csv R/xdet_panel_b.csv R/xdet_panel_c.csv R/xdet_panel_d.csv out/xdet-panel-b.tex out/xdet-panel-b-meta.tex out/xdet-panel-c.tex out/xdet-panel-d.tex tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-xdet.tex && mv fig-xdet.pdf ../$@

# ============================================================================
# TikZ-only figures (no R data, schematic/annotations)
# ============================================================================
$(CATTEX): data/gen_categorymap_tex.R data/categorymap_mvtec.csv data/categorymap_visa.csv data/categorymap_mpdd.csv
	cd data && $(RSCRIPT) gen_categorymap_tex.R

fig-categorymap.pdf: tikz/fig-categorymap.tex $(CATTEX) tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-categorymap.tex && $(PDFLATEX) fig-categorymap.tex && mv fig-categorymap.pdf ../$@

fig-overview.pdf: tikz/fig-overview.tex tikz/inspect_style.tex
	cd tikz && $(PDFLATEX) fig-overview.tex && mv fig-overview.pdf ../$@

# ============================================================================
# R/Cairo figures (raster-heavy content)
# ============================================================================
fig-samples.pdf: R/samples.R R/_samples_layout.R canonical_samples_assets/manifest.txt
	cd R && $(RSCRIPT) samples.R

fig-scoreanatomy.pdf: R/scoreanatomy.R data/frozen/scoreanatomy_points.json
	cd R && $(RSCRIPT) scoreanatomy.R

# ============================================================================
# Verification
# ============================================================================
verify: $(ALL_PDFS)
	@cd R && $(RSCRIPT) test_samples_layout.R
	@if $(MAKE) -n r-data | grep -Eiq '(^|[[:space:]])(python|python[0-9]+)([[:space:]]|$$)|\.py([[:space:]]|$$)'; then \
		echo "FATAL: r-data invokes Python; production figure generation must remain pure R"; exit 1; \
	fi
	@if grep -REn '/home/|/Users/' R/*.R data/*.R; then \
		echo "FATAL: machine-specific absolute path in active R generator"; exit 1; \
	fi
	@set -eu; \
	count=$$(printf '%s\n' $(ALL_PDFS) | wc -l); \
	test "$$count" -eq 18 || { echo "FATAL: expected 18 production PDFs, found $$count"; exit 1; }; \
	for pdf in $(ALL_PDFS); do \
		fonts=$$(pdffonts "$$pdf"); \
		printf '%s\n' "$$fonts" | awk 'NR > 2 && NF && $$(NF-4) != "yes" { print "FATAL: unembedded font in " file ": " $$0; bad=1 } END { exit bad }' file="$$pdf"; \
		if printf '%s\n' "$$fonts" | grep -Eiq 'Type[[:space:]]+3|Noto|Nimbus'; then \
			echo "FATAL: forbidden font in $$pdf"; exit 1; \
		fi; \
		printf '%s\n' "$$fonts" | awk 'NR > 2 && NF { name=$$1; sub(/^[A-Z][A-Z][A-Z][A-Z][A-Z][A-Z]\+/, "", name); if (name !~ /^(LM|CM|SF|Cm)/) { print "FATAL: non-LM/CM font in " file ": " name; bad=1 } } END { exit bad }' file="$$pdf"; \
		echo "PASS $$pdf"; \
	done

sync-rie: verify
	@mkdir -p $(RIE_FIG_DIR)
	@for pdf in $(ALL_PDFS); do cp "$$pdf" "$(RIE_FIG_DIR)/$$pdf"; done
	@for pdf in $(ALL_PDFS); do cmp -s "$$pdf" "$(RIE_FIG_DIR)/$$pdf" || { echo "FATAL: RiE sync mismatch for $$pdf"; exit 1; }; done
	@echo "PASS synced 18 production PDFs to $(RIE_FIG_DIR)"

sync-aei: verify
	@mkdir -p $(AEI_FIG_DIR)
	@for pdf in $(ALL_PDFS); do cp "$$pdf" "$(AEI_FIG_DIR)/$$pdf"; done
	@for pdf in $(ALL_PDFS); do cmp -s "$$pdf" "$(AEI_FIG_DIR)/$$pdf" || { echo "FATAL: AEI sync mismatch for $$pdf"; exit 1; }; done
	@echo "PASS synced 18 production PDFs to $(AEI_FIG_DIR) (papers/inspect-aei/figures)"

# Push identical bytes to both paper-facing figure dirs.
sync-paper: sync-rie sync-aei
	@echo "PASS paper figure dirs in sync (rie + aei)"

rie-paper: sync-paper
	cd ../rie && latexmk -pdf -interaction=nonstopmode -halt-on-error paper_rie.tex

clean:
	rm -f tikz/*.aux tikz/*.log tikz/*.out
	rm -f $(ALL_PDFS)
	rm -f fig_failurecases.pdf

# clean-data also removes all generated CSV digests and TikZ fragments, so a
# subsequent `make r-data all` is a true from-scratch reproduction. Use this to
# verify the dependency graph (no fig should build without its generator running).
clean-data: clean
	rm -f R/*.csv
	rm -f out/*.tex
	rm -f data/categorymap_*.tex

distclean: clean-data
